{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InvoiceEntityExtraction",
  "type": "object",
  "required": ["invoice_number", "vendor_name", "date", "total_amount", "currency", "line_items"],
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "total_amount": {
      "type": "number",
      "minimum": 0.0
    },
    "currency": {
      "type": "string",
      "enum": ["USD", "EUR", "GBP", "CAD", "JPY"]
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "quantity", "unit_price", "amount"],
        "properties": {
          "description": {"type": "string"},
          "quantity": {"type": "number"},
          "unit_price": {"type": "number"},
          "amount": {"type": "number"}
        }
      }
    }
  },
  "additionalProperties": false
}
