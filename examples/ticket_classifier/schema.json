{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SupportTicketClassification",
  "type": "object",
  "required": ["category", "confidence", "requires_escalation", "sla_hours"],
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "Network Outage",
        "Billing & Payments",
        "Authentication & 2FA",
        "Hardware Failure",
        "Technical Defect",
        "Feature Request",
        "Account Security & Compliance",
        "API & Rate Limits",
        "Integration & Webhooks",
        "Data Export & GDPR",
        "Onboarding & Setup",
        "General Inquiry"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "requires_escalation": {
      "type": "boolean"
    },
    "sla_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 72
    }
  },
  "additionalProperties": false
}
